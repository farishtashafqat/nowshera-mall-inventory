# Server-only configuration. Never put these values in frontend/.env files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase publishable/anon key for validating access tokens with Supabase Auth.
SUPABASE_ANON_KEY=
# Reserved for the Phase 6 AI Assistant; it is not used in Phase 1.
GEMINI_API_KEY=
# Configurable Gemini model for Phase 6; the key remains backend-only.
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated browser origins allowed during development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be listed in Supabase Auth > URL Configuration > Redirect URLs.
INVITE_REDIRECT_URL=http://localhost:5173/accept-invitation
